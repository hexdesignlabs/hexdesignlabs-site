---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found" description="The page you are looking for could not be found.">
	<main class="page">
		<section class="page-hero center">
			<p class="eyebrow">404</p>
			<h1>Page not found.</h1>
			<p class="lead">
				The page may have moved, or the link may need a quick tune-up.
			</p>
			<p>
				<a href="/" class="button primary">Return Home</a>
				<a href="/contact" class="button secondary">Contact HEX</a>
			</p>
		</section>
	</main>
</Layout>
