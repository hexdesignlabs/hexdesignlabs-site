---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Services" description="Website design, website management, content updates, landing pages, and marketing support from HEX Design Labs.">
	<main class="page">
		<section class="page-hero">
			<p class="eyebrow">Services</p>
			<h1>Web design, website management, and practical marketing support.</h1>
			<p class="lead">
				HEX helps small businesses launch stronger websites, refresh outdated pages, and keep their online presence maintained without adding another chore to the week.
			</p>
		</section>

		<section class="section">
			<div class="grid">
				<article class="card">
					<h3>Website Design</h3>
					<p>Custom business websites with clear structure, responsive layouts, brand-aligned visuals, and focused calls to action.</p>
				</article>
				<article class="card">
					<h3>Website Refreshes</h3>
					<p>Strategic improvements for existing websites that need cleaner messaging, better flow, or a more current visual direction.</p>
				</article>
				<article class="card">
					<h3>Website Management</h3>
					<p>Ongoing updates, content changes, monitoring, maintenance, and support for businesses that want a steady web partner.</p>
				</article>
				<article class="card">
					<h3>Landing Pages</h3>
					<p>Focused pages for campaigns, promotions, service launches, and lead generation.</p>
				</article>
				<article class="card">
					<h3>Content Support</h3>
					<p>Page planning, copy structure, service descriptions, and messaging cleanup for clearer customer communication.</p>
				</article>
				<article class="card">
					<h3>Marketing Design</h3>
					<p>Digital graphics and supporting materials that keep your website, campaigns, and brand touchpoints aligned.</p>
				</article>
			</div>
		</section>

		<section class="cta-band">
			<h2>Have a website project in mind?</h2>
			<p>Send over the details and HEX will help shape the next step.</p>
			<a href="/contact" class="button">Request Website Help</a>
		</section>
	</main>
</Layout>
