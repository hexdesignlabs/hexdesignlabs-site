---
import Layout from '../layouts/Layout.astro';
import backgroundPattern from '../assets/background.svg';
import contactHeroImage from '../assets/stock/le-vu-vSlCNmZdjHQ-unsplash.webp';

const formsparkActionUrl =
	import.meta.env.PUBLIC_FORMSPARK_CONTACT_ENDPOINT ??
	import.meta.env.PUBLIC_FORMSPARK_ACTION_URL ??
	'https://submit-form.com/echo';
const turnstileSitekey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY ?? '1x00000000000000000000AA';
const redirectUrl = 'https://hexdesignlabs.com/thank-you/';
---

<Layout title="Contact Us" description="Contact HEX Design Labs for small business website design, website refreshes, website support, content updates, and practical website management help.">
	<main class="contact">
		<section class="hero image-hero" style={`--hero-image: url(${contactHeroImage.src}); --hero-position: center; --hero-tint: #54B8ED;`}>
			<img class="hero-base-image" src={contactHeroImage.src} alt="" loading="eager" fetchpriority="high">
			<img class="hero-pattern-image" src={backgroundPattern.src} alt="" loading="eager" fetchpriority="high">
			<h1>Get in Touch</h1>
			<p>Ready to build, refresh, update, or better manage your small business website? Share what you need help with and HEX will review the next practical step.</p>
		</section>

		<section class="contact-section">
			<div class="contact-form">
				<h2>Send a Message</h2>
				<p class="form-intro">
					Use this form for website design inquiries, website refresh questions, content update requests, ongoing website support, or general small business website help. A short note about what feels unclear, outdated, or hard to manage is enough to start.
				</p>
				<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
				<form action={formsparkActionUrl} method="POST">
					<input type="hidden" name="_redirect" value={redirectUrl}>
					<input type="hidden" name="_append" value="false">
					<div class="form-group">
						<label for="name">Name</label>
						<input type="text" id="name" name="name" required>
					</div>
					<div class="form-group">
						<label for="email">Email</label>
						<input type="email" id="email" name="email" required>
					</div>
					<div class="form-group">
						<label for="company">Company Name</label>
						<input type="text" id="company" name="company">
					</div>
					<div class="form-group">
						<label for="website">Website</label>
						<input type="url" id="website" name="website">
					</div>
					<div class="form-group">
						<label for="message">Message</label>
						<textarea id="message" name="message" rows="5" required></textarea>
					</div>
					<div class="turnstile-wrap">
						<div class="cf-turnstile" data-sitekey={turnstileSitekey} data-action="contact" data-theme="dark"></div>
					</div>
					<div class="form-submit">
						<button type="submit" class="button primary">Send Message</button>
					</div>
				</form>
			</div>
		</section>
		<section class="form-next-actions" aria-labelledby="contact-next-actions">
			<h2 id="contact-next-actions">Looking for website support or a new website estimate?</h2>
			<p>Send the right details for content updates, website maintenance, a small business website redesign, or a new site build so HEX can review the next best step.</p>
			<div class="form-next-buttons">
				<a href="/support" class="button secondary">Submit a Support Request</a>
				<a href="/website-intake" class="button secondary">Start a Website Intake</a>
			</div>
		</section>
	</main>
</Layout>

<style>
	@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap');

	.contact {
		position: relative;
		isolation: isolate;
		width: 100%;
		margin: 0;
		padding: 56px 24px 72px;
		min-height: calc(100vh - 72px);
		min-height: calc(100svh - 72px);
		background: var(--color-surface);
		color: var(--color-text);
		font-family: 'Poppins', sans-serif;
	}

	.contact::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: var(--color-surface);
	}

	.hero {
		text-align: center;
		padding: 56px 0 40px;
		max-width: 860px;
		margin: 0 auto;
	}

	.hero.image-hero {
		position: relative;
		isolation: isolate;
		max-width: 1120px;
		min-height: clamp(380px, 52vh, 560px);
		margin-bottom: 40px;
		padding: clamp(80px, 12vw, 140px) clamp(24px, 6vw, 72px);
		overflow: hidden;
		border-radius: 20px;
		clip-path: inset(0 round 20px);
		background: var(--color-primary);
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
	}

	.hero.image-hero::before,
	.hero.image-hero::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
		pointer-events: none;
	}

	.hero.image-hero::before {
		z-index: 2;
		background: var(--hero-tint, rgba(84, 184, 237, 0.68));
		mix-blend-mode: multiply;
		opacity: 1;
		box-shadow:
			inset 0 0 0 1px rgba(255, 253, 247, 0.1),
			inset 18px 18px 42px rgba(17, 17, 17, 0.56),
			inset -18px -18px 42px rgba(17, 17, 17, 0.28);
	}

	.hero.image-hero::after {
		content: none;
	}

	.hero.image-hero > :not(img) {
		position: relative;
		z-index: 3;
	}

	.hero h1 {
		font-size: clamp(3rem, 7vw, 5.8rem);
		line-height: 1.06;
		margin: 0 0 24px;
		letter-spacing: -0.06em;
		color: var(--color-text);
	}

	.hero.image-hero h1,
	.hero.image-hero p {
		color: var(--color-on-surface-light);
	}

	.hero p {
		font-size: 1.18rem;
		max-width: 680px;
		margin: 0 auto;
		color: var(--color-body);
	}

	.contact-section {
		display: grid;
		grid-template-columns: 1fr;
		gap: 44px;
		margin-top: 8px;
		max-width: 1120px;
		margin-left: auto;
		margin-right: auto;
		border-radius: 20px;
		padding: 32px;
		background:
			radial-gradient(circle at 18% 12%, rgba(255, 253, 247, 0.38), transparent 30%),
			radial-gradient(circle at 82% 20%, rgba(84, 184, 237, 0.1), transparent 32%),
			radial-gradient(circle at 72% 88%, rgba(220, 79, 65, 0.07), transparent 34%),
			linear-gradient(145deg, rgba(255, 253, 247, 0.34), rgba(255, 253, 247, 0.2) 48%, rgba(255, 253, 247, 0.3));
		border: 1px solid rgba(255, 253, 247, 0.62);
		backdrop-filter: blur(18px) saturate(1.2);
		-webkit-backdrop-filter: blur(18px) saturate(1.2);
		animation: none !important;
		transform: none !important;
		box-shadow:
			inset 0 1px 0 rgba(255, 253, 247, 0.42),
			inset 18px 18px 42px rgba(255, 253, 247, 0.12),
			0 24px 80px rgba(17, 17, 17, 0.14);
	}

	.contact-form h2 {
		font-size: 2rem;
		margin-bottom: 12px;
		color: var(--color-text);
		text-align: center;
	}

	.form-intro {
		max-width: 760px;
		margin: 0 auto 28px;
		color: var(--color-body);
		font-size: 1rem;
		line-height: 1.7;
		text-align: center;
	}

	.form-group {
		margin-bottom: 20px;
	}

	.form-group label {
		display: block;
		margin-bottom: 8px;
		font-weight: 600;
		color: var(--color-text);
	}

	.form-group input,
	.form-group textarea {
		width: 100%;
		padding: 12px;
		border: 1px solid rgba(255, 253, 247, 0.34);
		border-radius: 10px;
		font-family: 'Poppins', sans-serif;
		font-size: 1rem;
		background: rgba(255, 253, 247, 0.18);
		color: var(--color-text);
		backdrop-filter: blur(10px) saturate(1.1);
		-webkit-backdrop-filter: blur(10px) saturate(1.1);
		box-shadow:
			inset 4px 4px 10px rgba(0, 0, 0, 0.06),
			inset -4px -4px 10px rgba(255, 253, 247, 0.08);
		transition: border-color 0.2s ease, box-shadow 0.2s ease;
	}

	.form-group input::placeholder,
	.form-group textarea::placeholder {
		color: rgba(17, 17, 17, 0.42);
	}

	.form-group input:focus,
	.form-group textarea:focus {
		border-color: rgba(255, 253, 247, 0.76);
		outline: none;
		box-shadow:
			inset 4px 4px 10px rgba(0, 0, 0, 0.08),
			inset -4px -4px 10px rgba(255, 253, 247, 0.1),
			0 0 0 3px rgba(255, 253, 247, 0.18);
	}

	.form-group textarea {
		resize: vertical;
	}

	.turnstile-wrap {
		margin: 0 0 20px;
		min-height: 65px;
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: 999px;
		padding: 14px 22px;
		text-decoration: none;
		font-weight: 700;
		transition: transform 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease, color 0.2s ease;
		background: var(--color-primary);
		color: var(--color-on-surface-light);
		border: none;
		outline: none;
		box-shadow: var(--shadow-button);
		cursor: pointer;
	}

	.secondary {
		background: var(--color-on-surface-light);
		color: var(--color-text);
	}

	.button:hover {
		background: var(--color-on-surface-light);
		color: var(--color-text);
	}

	.secondary:hover {
		background: var(--color-primary);
		color: var(--color-on-surface-light);
	}

	.form-next-buttons .button:nth-child(even) {
		background: var(--color-on-surface-light);
		color: var(--color-text);
	}

	.form-next-buttons .button:nth-child(odd) {
		background: var(--color-primary);
		color: var(--color-on-surface-light);
	}

	.form-next-buttons .button:nth-child(even):hover {
		background: var(--color-primary);
		color: var(--color-on-surface-light);
	}

	.form-next-buttons .button:nth-child(odd):hover {
		background: var(--color-on-surface-light);
		color: var(--color-text);
	}

	.form-submit {
		display: flex;
		justify-content: center;
	}

	.form-next-actions {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		max-width: 1120px;
		margin: 32px auto 0;
		min-height: 320px;
		padding: 72px 32px;
		border-radius: 20px;
		background: var(--color-strong);
		border: 0;
		text-align: center;
		box-shadow: var(--shadow-inset-box);
		animation: none !important;
		transform: none !important;
	}

	.form-next-actions h2,
	.form-next-actions p {
		color: var(--color-on-surface-light);
		max-width: 760px;
		margin-left: auto;
		margin-right: auto;
	}

	.form-next-actions h2 {
		margin: 0 0 10px;
		font-size: clamp(1.65rem, 3vw, 2.4rem);
		line-height: 1.08;
	}

	.form-next-actions p {
		max-width: 680px;
		margin: 0 auto 22px;
		line-height: 1.7;
	}

	.form-next-buttons {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		justify-content: center;
	}

	.form-next-actions .button {
		background: var(--color-on-surface-light);
		color: var(--color-text);
	}

	.form-next-actions .button:hover {
		background: var(--color-primary);
		color: var(--color-on-surface-light);
	}

	.button:focus,
	.button:focus-visible {
		outline: none;
	}

	a:not(.button) {
		color: #54B8ED;
		font-family: 'Poppins', sans-serif;
		font-weight: 700;
		text-decoration: none;
		transition: color 0.3s ease;
	}

	a:not(.button):hover {
		color: #DC4F41;
	}

	.button:hover {
		transform: translate(3px, 3px);
		box-shadow: var(--shadow-button-hover);
	}

	@media (max-width: 800px) {
		.contact-section {
			grid-template-columns: 1fr;
			padding: 24px 18px;
		}

		.contact {
			padding: 32px 18px 48px;
		}

		.hero {
			padding: 40px 0 28px;
		}
	}
</style>
