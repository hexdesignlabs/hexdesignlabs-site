---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => !data.draft);

	return posts.map((post) => ({
		params: { slug: post.id.replace(/\.(md|mdx)$/, '') },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);
const tags = post.data.tags ?? [];
const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});
const slug = post.id.replace(/\.(md|mdx)$/, '');
const canonicalUrl = `https://hexdesignlabs.com/blog/${slug}/`;
const modifiedTime = post.data.updatedDate?.toISOString();
---

<Layout
	title={post.data.title}
	description={post.data.description}
	canonical={canonicalUrl}
	ogImage={post.data.image}
	ogType="article"
	publishedTime={post.data.pubDate.toISOString()}
	modifiedTime={modifiedTime}
	tags={tags}
>
	<main class="page blog-post-page">
		<article class="blog-post">
			<header class="page-hero center blog-post-hero">
				<p class="eyebrow">Blog</p>
				<h1>{post.data.title}</h1>
				<p class="lead">{post.data.description}</p>
				<div class="post-meta">
					<span>{formattedDate}</span>
					<span>{post.data.author}</span>
				</div>
				<img class="post-hero-image" src={post.data.image} alt={post.data.imageAlt} loading="eager" fetchpriority="high" />
				{tags.length > 0 && (
					<div class="post-tags" aria-label="Tags">
						{tags.map((tag) => <span>{tag}</span>)}
					</div>
				)}
			</header>

			<div class="content-page post-content">
				<Content />
			</div>

			<div class="author-card">
				<img src="/images/uploads/annie-slovensky-profile.jpg" alt="Annie Slovensky" loading="lazy" />
				<div>
					<p class="author-name">Annie Slovensky</p>
					<p class="author-title">Creative Director &amp; Lead Web Designer</p>
				</div>
			</div>

			<section class="blog-post-cta">
				<h2>Ready to make your digital presence work harder?</h2>
				<p>HEX helps small businesses turn practical website notes into clearer pages, better customer paths, and a more manageable online presence.</p>
				<div class="blog-post-cta-actions">
					<a class="button blog-post-cta-primary" href="/contact">Contact us to learn more</a>
					<a class="button blog-post-cta-secondary" href="/blog">Check out some of our other blog posts</a>
				</div>
			</section>
		</article>
	</main>
</Layout>

<style>
	.blog-post-page {
		max-width: 960px;
	}

	.blog-post-hero {
		padding-bottom: 48px;
	}

	.post-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 10px 18px;
		justify-content: center;
		margin-top: 18px;
		font-weight: 700;
		color: var(--color-text);
	}

	.post-meta span + span::before {
		content: '';
		display: inline-block;
		width: 8px;
		height: 8px;
		margin-right: 18px;
		border-radius: 999px;
		background: var(--color-accent);
		vertical-align: middle;
	}

	.post-hero-image {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		max-height: 520px;
		margin-top: 36px;
		border-radius: 20px;
		object-fit: cover;
		box-shadow: var(--shadow-primary), var(--shadow-inset-box);
	}

	.post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		justify-content: center;
		margin-top: 24px;
	}

	.post-tags span {
		border-radius: 999px;
		padding: 8px 12px;
		background: var(--color-primary);
		color: var(--color-on-surface-light);
		font-size: 0.82rem;
		font-weight: 700;
	}

	.author-card {
		display: flex;
		align-items: center;
		gap: 16px;
		max-width: 880px;
		margin: 16px auto 48px;
		width: min(100%, 880px);
		text-align: left;
	}

	.author-card img {
		flex: 0 0 72px;
		width: 72px;
		height: 72px;
		border: 2px solid var(--color-primary);
		border-radius: 999px;
		object-fit: cover;
	}

	.author-card p {
		margin: 0;
		line-height: 1.35;
	}

	.author-name {
		color: var(--color-text);
		font-weight: 700;
	}

	.author-title {
		margin-top: 4px;
		color: var(--color-body);
		font-size: 10pt;
		font-weight: 400;
	}

	.post-content {
		margin: 0 auto;
		padding-bottom: 32px;
	}

	.post-content :global(p),
	.post-content :global(li) {
		font-size: 1.06rem;
		line-height: 1.85;
	}

	.post-content :global(h2) {
		margin-top: 48px;
	}

	.post-content :global(ul),
	.post-content :global(ol) {
		padding-left: 1.4rem;
	}

	.post-content :global(blockquote) {
		margin: 36px 0;
		border-left: 6px solid var(--color-accent);
		padding: 18px 0 18px 24px;
		font-weight: 700;
	}

	.blog-post-cta {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		background: var(--color-strong);
		color: var(--color-on-surface-light);
		border: 0;
		border-radius: 20px;
		min-height: 320px;
		padding: 72px 32px;
		margin-top: 48px;
		box-shadow: var(--shadow-inset-box);
	}

	.blog-post-cta h2,
	.blog-post-cta p {
		color: var(--color-on-surface-light);
		max-width: 760px;
		margin-left: auto;
		margin-right: auto;
	}

	.blog-post-cta p {
		margin-top: 0;
	}

	.blog-post-cta-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		justify-content: center;
		margin-top: 24px;
	}

	.blog-post-cta-actions .button {
		max-width: 420px;
		margin-top: 0;
	}

	.blog-post-cta-primary {
		background: var(--color-primary);
		color: var(--color-on-surface-light);
	}

	.blog-post-cta-primary:hover {
		background: var(--color-on-surface-light);
		color: var(--color-text);
		cursor: var(--hex-cursor-dark) !important;
	}

	.blog-post-cta-secondary {
		background: var(--color-on-surface-light);
		color: var(--color-text);
	}

	.blog-post-cta-secondary:hover {
		background: var(--color-primary);
		color: var(--color-on-surface-light);
		cursor: var(--hex-cursor-light) !important;
	}

	@media (max-width: 640px) {
		.blog-post-hero {
			text-align: left;
		}

		.post-meta,
		.post-tags {
			justify-content: flex-start;
		}

		.author-card {
			align-items: flex-start;
		}

		.post-meta span + span::before {
			content: none;
		}

		.blog-post-cta {
			align-items: flex-start;
			text-align: left;
			padding: 56px 22px;
		}

		.blog-post-cta-actions {
			justify-content: flex-start;
		}
	}
</style>
