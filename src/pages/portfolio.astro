---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Portfolio" description="Explore sample website and design work categories from HEX Design Labs, including small business websites, service pages, and marketing support.">
	<main class="page">
		<section class="page-hero">
			<p class="eyebrow">Portfolio</p>
			<h1>Selected work and project directions.</h1>
			<p class="lead">
				This page is ready for case studies, project screenshots, and live website examples as the portfolio grows.
			</p>
		</section>

		<section class="section">
			<div class="grid">
				<article class="card accent-card">
					<h3>Small Business Websites</h3>
					<p>Professional websites for local businesses that need clear service information and direct inquiry paths.</p>
				</article>
				<article class="card">
					<h3>Website Refreshes</h3>
					<p>Modernized layouts, tighter messaging, and cleaner navigation for existing websites.</p>
				</article>
				<article class="card">
					<h3>Service Pages</h3>
					<p>Focused pages built to explain offers, improve search visibility, and guide visitors toward contact.</p>
				</article>
			</div>
		</section>

		<section class="section two-column">
			<div>
				<h2>Need this filled with real work?</h2>
				<p>
					Add project names, screenshots, industries, outcomes, and live URLs here when the final portfolio assets are ready.
				</p>
			</div>
			<div class="card">
				<h3>Case study format</h3>
				<p>Project overview, challenge, solution, services used, and a final link or image gallery.</p>
			</div>
		</section>
	</main>
</Layout>
