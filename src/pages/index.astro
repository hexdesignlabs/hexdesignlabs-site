---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
---

<Layout title="HEX Design Labs" description="HEX Design Labs builds, refreshes, and manages professional websites for small businesses that need practical design and reliable support.">
	<Hero />
	<main class="home">
		<section class="section">
			<p class="eyebrow">What We Do</p>
			<h2>Design, support, and website management for businesses that need things handled.</h2>

			<div class="cards">
				<a href="/services" class="card">
					<h3>Website Design</h3>
					<p>Clean, modern websites built around your business goals, brand, and customer experience.</p>
				</a>

				<a href="/services" class="card">
					<h3>Website Management</h3>
					<p>Ongoing website support for updates, maintenance, monitoring, and small content changes.</p>
				</a>

				<a href="/services" class="card">
					<h3>Marketing Support</h3>
					<p>Design and content support for service pages, landing pages, social graphics, and campaign materials.</p>
				</a>
			</div>
		</section>

		<section class="highlight">
			<div>
				<p class="eyebrow">Website Management</p>
				<h2>Your website should not become another thing you have to babysit.</h2>
				<p>
					HEX provides ongoing website support for businesses that need a reliable partner to help keep their site updated, protected, and professionally maintained.
				</p>
			</div>

			<a href="/services" class="button primary">Learn More</a>
		</section>

		<section class="section">
			<p class="eyebrow">Who We Help</p>
			<h2>Built for practical businesses that need clear, credible websites.</h2>

			<div class="pill-grid">
				<span>Small Businesses</span>
				<span>Law Firms</span>
				<span>Restaurants & Bars</span>
				<span>Construction</span>
				<span>MSPs</span>
				<span>Salons</span>
				<span>Daycares</span>
				<span>Pet Groomers</span>
				<span>Manufacturing</span>
				<span>Service Businesses</span>
			</div>
		</section>

		<section class="cta">
			<h2>Need help with your website?</h2>
			<p>Let’s figure out what your site needs and whether HEX is the right fit.</p>
			<a href="/contact" class="button primary">Start the Conversation</a>
		</section>
	</main>
</Layout>

<style>
@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap');
.home {
	max-width: 1120px;
	margin: 0 auto;
	padding: 72px 24px;
	color: var(--color-text);
	font-family: 'Poppins', sans-serif;

	}

	.eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.12em;
		font-size: 0.78rem;
		font-weight: 700;
		color: var(--color-muted);
		margin-bottom: 16px;
	}

	h1 {
		font-size: clamp(3rem, 7vw, 5.8rem);
		line-height: 0.95;
		margin: 0 0 24px;
		letter-spacing: -0.06em;
		color: var(--color-text)
		
	}

	h2 {
		font-size: clamp(2rem, 4vw, 3.2rem);
		line-height: 1;
		margin: 0 0 20px;
		letter-spacing: -0.045em;
		color: var(--color-text)
	}

	h3 {
		font-size: 1.25rem;
		margin: 0 0 12px;
		color: var(--color-text);
	}

	p {
		font-size: 1rem;
		line-height: 1.7;
		color: var(--color-body);
		margin: 0;
	}

	.hero-text {
		font-size: 1.18rem;
		max-width: 680px;
	}

	.hero {
		margin-bottom: 40px;
	}

	.hero-buttons {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		margin-top: 32px;
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: 999px;
		padding: 14px 22px;
		text-decoration: none;
		font-weight: 700;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
		border: 1px solid var(--color-border);
	}

	a:not(.button) {
		color: #54B8ED;
		font-family: 'Poppins', sans-serif;
		font-weight: 700;
		text-decoration: none;
		transition: color 0.3s ease;
	}

	a:not(.button):hover {
		color: #DC4F41;
	}

	.button:hover {
		transform: translateY(-2px);
	}

	.primary {
		background: var(--color-strong);
		color: var(--color-on-surface-light);
		box-shadow: var(--shadow-primary);
	}

	.secondary {
		background: var(--color-surface-muted);
		color: var(--color-on-surface-dark);
	}

	.section {
		padding: 72px 0;
		border-top: 1px solid var(--color-border);
	}

	.home > .section:first-child {
		border-top: 0;
	}

	.cards {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 20px;
		margin-top: 36px;
	}

	.card {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 24px;
		padding: 28px;
		display: block;
		color: var(--color-text);
		text-decoration: none;
		transition: background 0.25s ease, box-shadow 0.25s ease, color 0.25s ease, transform 0.25s ease;
	}

	.card:hover {
		background: var(--color-strong);
		color: var(--color-on-surface-light);
		box-shadow:
			0 0 0 6px rgba(255, 255, 255, 0.18),
			0 0 34px rgba(255, 255, 255, 0.34),
			0 22px 44px rgba(17, 17, 17, 0.22);
		transform: translateY(-8px);
	}

	.card:hover h3,
	.card:hover p {
		color: var(--color-on-surface-light);
	}

	.highlight {
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: center;
		gap: 32px;
		background: var(--color-surface-muted);
		border-radius: 32px;
		padding: 44px;
		margin: 32px 0;
	}

	.pill-grid {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 32px;
	}

	.pill-grid span {
		background: var(--color-surface-muted);
		border: 1px solid var(--color-border);
		border-radius: 999px;
		padding: 10px 16px;
		font-weight: 600;
		color: var(--color-on-surface-dark);
	}

	.cta {
		text-align: center;
		background: var(--color-strong);
		color: var(--color-on-surface-light);
		border-radius: 36px;
		padding: 64px 24px;
		margin-top: 56px;
	}

	.cta h2 {
		color: var(--color-on-surface-light);
	}

	.cta p {
		color: var(--color-on-muted);
		margin-bottom: 28px;
	}

	.cta .primary {
		background: var(--color-on-surface-light);
		color: var(--color-on-surface-dark);
	}

	@media (max-width: 800px) {
		.cards,
		.highlight {
			grid-template-columns: 1fr;
		}

		.home {
			padding: 40px 18px;
		}

		.hero {
			padding: 48px 0 64px;
		}
	}
</style>
