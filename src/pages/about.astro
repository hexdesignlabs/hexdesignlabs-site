---
import Layout from '../layouts/Layout.astro';
import backgroundPattern from '../assets/background.svg';
import aboutHeroImage from '../assets/stock/kevin-matos-Nl_FMFpXo2g-unsplash.jpg';
import aboutGuideImage from '../assets/stock/austin-distel-wD1LRb9OeEo-unsplash.jpg';
---

<Layout title="About HEX Design Labs" description="Learn about HEX Design Labs, a small business website design and website support studio helping owners plan, refresh, update, and manage practical business websites.">
	<main class="page">
		<section class="page-hero image-hero" style={`--hero-image: url(${aboutHeroImage.src}); --hero-position: center; --hero-tint: #DC4F41;`}>
			<img class="hero-base-image" src={aboutHeroImage.src} alt="" loading="eager" fetchpriority="high">
			<img class="hero-pattern-image" src={backgroundPattern.src} alt="" loading="eager" fetchpriority="high">
			<p class="eyebrow">About HEX</p>
			<h1>Website design and support for businesses that need things handled with care.</h1>
			<p class="lead">
				HEX Design Labs helps small businesses turn scattered website needs into clearer, more useful online systems: sharp pages, sensible structure, stronger website copy, and ongoing support after launch.
			</p>
		</section>

		<section class="section two-column">
			<div>
				<h2>Built for practical momentum.</h2>
				<p>
					We focus on websites that are easy to understand, easier to maintain, and strong enough to represent the business behind them. The work blends brand thinking, small business web design, copy structure, content planning, and reliable technical execution so owners have a clearer place to send customers when they ask, "Where can we learn more?"
				</p>
				<p>
					Some businesses need a new website. Others need website help with a refresh, a cleaner contact page, better service descriptions, or ongoing website management after the site is live. HEX keeps the conversation grounded in what is useful, realistic, and manageable for the business.
				</p>
			</div>
			<div class="card accent-card">
				<h3>What guides the work</h3>
				<p>Clear messaging, responsive layouts, practical website support, dependable maintenance, and a low-drama process that keeps decisions moving.</p>
				<div class="accent-card-media">
					<img src={aboutGuideImage.src} alt="A team reviewing website project priorities on a whiteboard" loading="lazy">
				</div>
			</div>
		</section>

		<section class="section">
			<p class="eyebrow">How We Work</p>
			<h2>Simple process, useful outcomes.</h2>
			<div class="grid">
				<article class="card process-card-red">
					<h3>Clarify</h3>
					<p>We define the website goal, audience, content needs, service information, and practical constraints before design starts.</p>
				</article>
				<article class="card process-card-blue">
					<h3>Create</h3>
					<p>We design and build pages that feel credible, load cleanly, explain the business clearly, and guide visitors toward a reasonable next action.</p>
				</article>
				<article class="card process-card-green">
					<h3>Maintain</h3>
					<p>We support content updates, improvements, and site care so the website has a practical path forward after launch.</p>
				</article>
			</div>
		</section>

		<section class="cta-band">
			<h2>Ready for a clearer small business website?</h2>
			<p>Bring HEX into the conversation when your website needs stronger structure, sharper service pages, better content, or practical support after launch.</p>
			<a href="/contact" class="button">Contact HEX</a>
		</section>
	</main>
</Layout>

<style>
	.process-card-red,
	.process-card-blue,
	.process-card-green {
		border: 0;
	}

	.process-card-red {
		background: var(--color-strong);
	}

	.process-card-blue {
		background: var(--color-surface);
	}

	.process-card-green {
		background: var(--color-accent);
	}

	.process-card-red h3,
	.process-card-red p {
		color: var(--color-on-surface-light);
	}

	.accent-card {
		overflow: hidden;
	}

	.accent-card-media {
		position: relative;
		width: 100%;
		max-width: 100%;
		aspect-ratio: 16 / 10;
		margin-top: 22px;
		border-radius: 14px;
		overflow: hidden;
	}

	.accent-card-media::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
		box-shadow:
			inset 0 0 0 1px rgba(255, 253, 247, 0.18),
			inset 14px 14px 30px rgba(17, 17, 17, 0.42),
			inset -12px -12px 24px rgba(255, 253, 247, 0.12);
		pointer-events: none;
	}

	.accent-card-media img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
</style>
