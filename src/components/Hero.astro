---
import background from '../assets/background.svg';
import virtualGraphic from '../assets/faizur-rehman-pHPzdEHN6Os-unsplash.webp';
import logo from '../assets/2023 HEX Logo Icon First Dark.svg';
---

<section class="hero-shell" aria-labelledby="hero-title">
	<img class="hero-base-image" src={virtualGraphic.src} alt="" fetchpriority="high" />
	<img class="hero-background" src={background.src} alt="" fetchpriority="high" />
	<div class="hero-overlay"></div>

	<div class="hero-content">
		<div class="hero-copy">
			<p class="hero-kicker">HEX Design Labs</p>
			<h1 id="hero-title">Website Design and Support for Your Business</h1>
			<p class="hero-subtitle">
				Small business website design, website refreshes, and ongoing website support for owners who need a clearer, easier-to-manage online presence.
			</p>
			<div class="hero-actions">
				<a class="hero-button button" href="/website-intake"><span>Let's Build Your Website</span></a>
				<a class="hero-button button" href="/contact"><span>Need Website Help?</span></a>
			</div>
		</div>

		<div class="hero-showcase" aria-hidden="true">
			<div class="brand-device">
				<div class="phone-screen-content">
					<img src={logo.src} alt="" />
					<div class="screen-lines">
						<span></span>
						<span></span>
						<span></span>
					</div>
					<div class="screen-card">
						<strong>Website Support</strong>
						<small>Web Design + management</small>
					</div>
				</div>
			</div>
		</div>

	</div>
</section>

<style>
	.hero-shell {
		position: relative;
		width: 100%;
		max-width: 100vw;
		min-height: calc(100vh - 72px);
		min-height: calc(100svh - 72px);
		overflow: hidden;
		background: #111111;
		isolation: isolate;
	}

	.hero-base-image,
	.hero-background {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.hero-base-image {
		z-index: 0;
	}

	.hero-background {
		transform: scale(1.18) rotate(-7deg);
		filter: saturate(1.45) contrast(1.12);
		z-index: 1;
		animation: background-drift 36s ease-in-out infinite alternate;
	}

	.hero-overlay {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(circle at 72% 34%, rgba(172, 188, 59, 0.78), transparent 28%),
			radial-gradient(circle at 32% 55%, rgba(84, 184, 237, 0.72), transparent 46%),
			linear-gradient(90deg, rgba(17, 17, 17, 0.86) 0%, rgba(17, 17, 17, 0.52) 42%, rgba(17, 17, 17, 0.2) 100%);
		z-index: 2;
	}

	.hero-content {
		position: relative;
		z-index: 3;
		display: grid;
		grid-template-columns: minmax(0, 710px) minmax(230px, 292px);
		align-items: center;
		column-gap: 70px;
		min-height: inherit;
		max-width: 1120px;
		margin: 0 auto;
		padding: clamp(84px, 9vh, 116px) 24px clamp(96px, 10vw, 140px);
	}

	.hero-copy {
		max-width: 660px;
		color: var(--color-on-surface-light);
	}

	.hero-kicker {
		margin: 0 0 22px;
		color: #54b8ed;
		font-size: 0.82rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		animation: copy-rise 1280ms cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	h1 {
		margin: 0;
		color: var(--color-on-surface-light);
		font-size: clamp(3rem, 7vw, 5.8rem);
		font-weight: 700;
		line-height: 1.06;
		letter-spacing: -0.06em;
		max-width: 660px;
		animation: headline-slide 1640ms 120ms cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.hero-subtitle {
		margin: 28px 0 0;
		max-width: 610px;
		color: rgba(255, 253, 247, 0.9);
		font-size: clamp(1rem, 1.25vw, 1.2rem);
		font-weight: 400;
		line-height: 1.45;
		animation: copy-rise 1520ms 520ms cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
		margin-top: 46px;
		animation: copy-rise 1520ms 700ms cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.hero-button {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 54px;
		padding: 0 30px;
		border-radius: 999px;
		background: var(--color-primary);
		border: none;
		outline: none;
		color: var(--color-on-surface-light);
		font-weight: 700;
		text-decoration: none;
		box-shadow: var(--shadow-button);
		overflow: hidden;
		isolation: isolate;
		transition: transform 0.42s ease, box-shadow 0.42s ease;
	}

	.hero-button span {
		position: relative;
		z-index: 1;
	}

	.hero-button:hover {
		background: var(--color-on-surface-light);
		color: var(--color-text);
		cursor: var(--hex-cursor-dark) !important;
		transform: translate(3px, 3px) scale(1.02);
		box-shadow: var(--shadow-button-hover);
	}

	.hero-button:focus,
	.hero-button:focus-visible {
		outline: none;
	}

	.hero-actions .hero-button:nth-child(even) {
		background: var(--color-primary);
		color: var(--color-on-surface-light);
	}

	.hero-actions .hero-button:nth-child(even):hover {
		background: var(--color-on-surface-light);
		color: var(--color-text);
		cursor: var(--hex-cursor-dark) !important;
	}

	.hero-actions .hero-button:nth-child(odd) {
		background: var(--color-on-surface-light);
		color: var(--color-text);
	}

	.hero-actions .hero-button:nth-child(odd):hover {
		background: var(--color-primary);
		color: var(--color-on-surface-light);
		cursor: var(--hex-cursor-light) !important;
	}

	.hero-showcase {
		display: flex;
		justify-content: flex-start;
		align-self: stretch;
		align-items: flex-start;
		padding-top: clamp(58px, 8vh, 96px);
		justify-self: start;
		pointer-events: none;
	}

	.brand-device {
		position: relative;
		width: clamp(230px, 20vw, 292px);
		aspect-ratio: 0.47;
		border: 0;
		border-radius: clamp(34px, 4.2vw, 42px);
		background:
			linear-gradient(25deg, rgba(220, 79, 65, 0.82) 0%, rgba(84, 184, 237, 0.9) 38%, rgba(233, 247, 252, 0.96) 62%, rgba(255, 253, 247, 0.98) 100%),
			#54b8ed;
		box-shadow:
			0 0 0 8px #111111,
			inset 0 0 0 2px rgba(255, 253, 247, 0.16),
			0 36px 90px rgba(17, 17, 17, 0.45);
		overflow: hidden;
		animation: device-enter 1800ms 1120ms cubic-bezier(0.22, 1, 0.36, 1) both, device-float 12s 3s ease-in-out infinite;
	}

	.brand-device::before {
		content: '';
		position: absolute;
		top: 12px;
		left: 50%;
		width: clamp(54px, 26%, 68px);
		height: clamp(14px, 2vw, 17px);
		border-radius: 999px;
		background: #111111;
		transform: translateX(-50%);
		z-index: 2;
	}

	.phone-screen-content {
		position: absolute;
		top: 50%;
		left: 50%;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 52px;
		width: calc(100% - 56px);
		height: min(500px, calc(100% - 112px));
		transform: translate(-50%, -50%);
	}

	.phone-screen-content img {
		width: 176px;
		max-width: 100%;
		height: auto;
	}

	.screen-lines {
		width: 100%;
		display: grid;
		gap: 12px;
	}

	.screen-lines span {
		display: block;
		height: 14px;
		border-radius: 999px;
		background: rgba(255, 253, 247, 0.52);
		transform-origin: left center;
		animation: line-fill 1800ms 2200ms cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.screen-lines span:nth-child(2) {
		width: 72%;
		animation-delay: 2420ms;
	}

	.screen-lines span:nth-child(3) {
		width: 54%;
		animation-delay: 2640ms;
	}

	.screen-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		width: 100%;
		box-sizing: border-box;
		padding: 18px 16px;
		border-radius: 24px;
		background: rgba(255, 253, 247, 0.5);
		color: #111111;
		text-align: center;
		border: 1px solid rgba(255, 253, 247, 0.58);
		box-shadow:
			inset 0 1px 0 rgba(255, 253, 247, 0.32),
			0 20px 50px rgba(17, 17, 17, 0.18);
		animation: card-rise 1600ms 2860ms cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.screen-card strong,
	.screen-card small {
		display: block;
		text-align: center;
		max-width: 100%;
		overflow-wrap: normal;
	}

	.screen-card strong {
		font-size: clamp(0.82rem, 3.6vw, 1rem);
		line-height: 1.12;
		white-space: nowrap;
	}

	.screen-card small {
		margin-top: 6px;
		color: rgba(17, 17, 17, 0.7);
		font-weight: 700;
		font-size: clamp(0.78rem, 3.4vw, 0.96rem);
		line-height: 1.28;
	}

	@keyframes copy-rise {
		from {
			opacity: 0;
			transform: translateY(18px);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes headline-slide {
		from {
			opacity: 0;
			transform: translateX(-42px);
		}

		to {
			opacity: 1;
			transform: translateX(0);
		}
	}

	@keyframes device-enter {
		from {
			opacity: 0;
			transform: translateX(28px) rotate(2deg) scale(0.96);
		}

		to {
			opacity: 1;
			transform: translateX(0) rotate(0deg) scale(1);
		}
	}

	@keyframes device-float {
		0%,
		100% {
			transform: translateY(0) rotate(0deg);
		}

		50% {
			transform: translateY(-10px) rotate(-1deg);
		}
	}

	@keyframes line-fill {
		from {
			opacity: 0;
			transform: scaleX(0);
		}

		to {
			opacity: 1;
			transform: scaleX(1);
		}
	}

	@keyframes card-rise {
		from {
			opacity: 0;
			transform: translateY(120px);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes background-drift {
		from {
			transform: scale(1.18) rotate(-7deg) translate3d(-1%, -1%, 0);
		}

		to {
			transform: scale(1.22) rotate(-5deg) translate3d(1%, 1%, 0);
		}
	}

	@media (max-width: 980px) {
		.hero-shell {
			min-height: 100vh;
			min-height: 100svh;
		}

		.hero-content {
			grid-template-columns: 1fr;
			justify-items: center;
			align-content: center;
			gap: 56px;
			padding: 72px 28px 96px;
			text-align: center;
		}

		.hero-showcase {
			justify-content: center;
			align-items: center;
			justify-self: center;
			padding-top: 0;
		}

		h1 {
			max-width: 680px;
			font-size: clamp(2.24rem, 8vw, 3.84rem);
		}

		.hero-copy,
		.hero-subtitle {
			margin-left: auto;
			margin-right: auto;
		}

		.hero-button {
			margin-left: auto;
			margin-right: auto;
		}

		.hero-actions {
			justify-content: center;
		}

		.brand-device {
			width: clamp(230px, 52vw, 280px);
		}

		.phone-screen-content {
			gap: 34px;
			width: calc(100% - 40px);
			height: calc(100% - 92px);
		}

		.phone-screen-content img {
			width: min(160px, 78%);
		}

		.screen-card {
			width: min(100%, 196px);
			padding: 16px 12px;
		}

		.screen-card strong {
			font-size: 0.86rem;
		}

	}

	@media (max-width: 640px) {
		.hero-shell {
			min-height: 100vh;
			min-height: 100svh;
		}

		.hero-content {
			padding: 56px 20px 72px;
		}

		.hero-kicker {
			text-align: center;
		}

		h1 {
			margin-top: clamp(40px, 8vh, 72px);
			font-size: clamp(2.04rem, 9.6vw, 2.88rem);
			text-align: center;
		}

		.hero-subtitle {
			margin-top: 24px;
			text-align: center;
		}

		.phone-screen-content {
			gap: 28px;
			width: calc(100% - 36px);
			height: calc(100% - 88px);
		}

		.phone-screen-content img {
			width: min(148px, 76%);
		}

		.screen-card {
			width: min(100%, 184px);
			padding: 15px 12px;
		}

		.screen-card strong {
			font-size: 0.82rem;
		}

		.screen-card small {
			font-size: 0.8rem;
			line-height: 1.28;
		}
	}

	@media (max-width: 520px) {
		.brand-device {
			width: min(250px, 68vw);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-background,
		.hero-kicker,
			h1,
			.hero-subtitle,
			.hero-actions,
			.hero-button,
		.brand-device,
		.screen-lines span,
		.screen-card {
			animation: none;
		}
	}
</style>
