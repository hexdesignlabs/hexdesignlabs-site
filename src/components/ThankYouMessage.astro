---
const { heading, body, buttonText = 'Back to Home', href = '/' } = Astro.props;
---

<main class="thank-you-page">
	<section class="thank-you-panel">
		<h1>{heading}</h1>
		<p>{body}</p>
		<a href={href} class="button primary">{buttonText}</a>
	</section>
</main>

<style>
	.thank-you-page {
		max-width: 1120px;
		margin: 0 auto;
		padding: 96px 24px;
		color: var(--color-text);
		font-family: 'Poppins', sans-serif;
	}

	.thank-you-panel {
		max-width: 820px;
		margin: 0 auto;
		text-align: center;
		padding: 72px 24px;
		border-radius: 20px;
	}

	.thank-you-panel h1 {
		font-size: clamp(3rem, 7vw, 5.8rem);
		line-height: 1.06;
		margin: 0 0 24px;
		letter-spacing: -0.06em;
		color: var(--color-text);
	}

	.thank-you-panel p {
		max-width: 680px;
		margin: 0 auto 28px;
		font-size: 1.1rem;
		line-height: 1.7;
		color: var(--color-body);
	}

	@media (max-width: 800px) {
		.thank-you-page {
			padding: 56px 18px;
		}

		.thank-you-panel {
			padding: 48px 0;
		}
	}
</style>
