---
import logoLight from '../assets/2023 HEX Logo Icon First Light.svg';
import backgroundPattern from '../assets/background.svg';
import hexCursor from '../assets/hex cursor.svg';
import hexCursorHover from '../assets/hex cursor hover.svg';

const {
	title = 'Small Business Website Design & Support | HEX Design Labs',
	description = 'HEX Design Labs provides small business website design, website refreshes, website support, content updates, and practical website management help.',
	canonical,
	ogImage,
	ogType = 'website',
	publishedTime,
	modifiedTime,
	tags = []
} = Astro.props;

const pageTitle = title.includes('HEX Design Labs') ? title : `${title} | HEX Design Labs`;
const siteUrl = 'https://hexdesignlabs.com';
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).toString();
const socialImage = ogImage
	? new URL(ogImage, siteUrl).toString()
	: new URL(logoLight.src, Astro.site ?? siteUrl).toString();
---

<!doctype html>
<html lang="en">
	<head>
		<!-- Google Tag Manager -->
		<script>
			(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
			new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
			j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
			'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
			})(window,document,'script','dataLayer','GTM-NV9RV3QH');
		</script>
		<!-- End Google Tag Manager -->
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="keywords" content="small business website design, website help, website support, website management, website refresh, business website design, local business website, website content updates, Scottsdale web design" />
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={socialImage} />
		{publishedTime && <meta property="article:published_time" content={publishedTime} />}
		{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
		{tags.map((tag) => <meta property="article:tag" content={tag} />)}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImage} />
		<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "LocalBusiness",
			"name": "HEX Design Labs",
			"description": "Small business website design, website refreshes, website support, content updates, and practical website management.",
			"url": "https://hexdesignlabs.com",
			"email": "info@hexdesignlabs.com",
			"address": {
				"@type": "PostalAddress",
				"addressLocality": "Scottsdale",
				"addressRegion": "AZ",
				"addressCountry": "US"
			},
			"serviceType": ["Website Design", "Website Management", "Website Creation"],
			"areaServed": "Scottsdale, AZ",
			"sameAs": [
				"https://www.google.com/business/profile/hex-design-labs"
			]
		}
		</script>
		<title>{pageTitle}</title>
	</head>
	<body style={`--site-background-svg: url(${backgroundPattern.src}); --hex-cursor-dark: url("${hexCursor.src}") 0 0, auto; --hex-cursor-light: url("${hexCursorHover.src}") 0 0, auto;`}>
		<!-- Google Tag Manager (noscript) -->
		<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NV9RV3QH"
		height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
		<!-- End Google Tag Manager (noscript) -->
		<header class="header">
			<div class="container header-content">
				<a href="/" class="logo-link">
					<img src={logoLight.src} alt="HEX Design Labs Logo" class="logo" />
				</a>
				<nav class="nav desktop-nav">
					<a href="/about" class="nav-link">About</a>
					<a href="/services" class="nav-link">Services</a>
					<a href="/blog" class="nav-link">Blog</a>
					<div class="nav-item has-submenu">
						<a href="/contact" class="nav-link">Contact</a>
						<div class="submenu" aria-label="Contact options">
							<a href="/support">Support Request</a>
							<a href="/website-intake">Website Intake</a>
						</div>
					</div>
				</nav>
				<div class="mobile-menu">
					<input class="mobile-menu-toggle" type="checkbox" id="mobile-menu-toggle" aria-label="Toggle navigation menu" />
					<label class="mobile-menu-button" for="mobile-menu-toggle">
						<span></span>
						<span></span>
						<span></span>
					</label>
					<nav class="mobile-nav">
						<a href="/" class="nav-link">Home</a>
						<a href="/about" class="nav-link">About</a>
						<a href="/services" class="nav-link">Services</a>
						<a href="/blog" class="nav-link">Blog</a>
						<a href="/contact" class="nav-link">Contact</a>
						<a href="/support" class="nav-link nav-sublink">Support Request</a>
						<a href="/website-intake" class="nav-link nav-sublink">Website Intake</a>
					</nav>
				</div>
			</div>
		</header>
		<slot />
		<div class="footer-spacer" aria-hidden="true"></div>
		<footer class="footer">
			<div class="container">
				<div class="footer-contact">
					<a href="/" class="footer-logo-link">
						<img src={logoLight.src} alt="HEX Design Labs Logo" class="footer-logo" />
					</a>
					<p class="footer-email"><a href="mailto:info@hexdesignlabs.com">info@hexdesignlabs.com</a></p>
					<p class="footer-links">
						<a href="/">Home</a>
						<a href="/about">About</a>
						<a href="/services">Services</a>
						<a href="/blog">Blog</a>
						<a href="/contact">Contact</a>
						<a href="/support">Support Request</a>
						<a href="/website-intake">Website Intake</a>
						<a href="/privacy-policy">Privacy Policy</a>
						<a href="/terms">Terms</a>
						<a href="https://www.google.com/search?q=HEX+Design+Labs" target="_blank" rel="noopener noreferrer">Find HEX on Google</a>
					</p>
				</div>
			</div>
		</footer>
		<script>
			(() => {
				const sectionSelector = [
					'section:not(.form-section):not(.contact-section):not(.hero-shell):not(.page-hero):not(.form-hero):not(.hero.image-hero)'
				].join(',');
				const itemSelector = [
					':scope > .eyebrow',
					':scope > h1',
					':scope > h2',
					':scope > h3',
					':scope > p',
					':scope > .lead',
					':scope > .section-intro',
					':scope > .copy-stack',
					':scope > .pill-grid',
					':scope > .cta-actions',
					':scope > .button',
					':scope > a.button',
					':scope > div > .eyebrow',
					':scope > div > h1',
					':scope > div > h2',
					':scope > div > h3',
					':scope > div > p',
					':scope > div > .lead',
					':scope > div > .section-intro',
					':scope > div > .copy-stack',
					':scope > div > .button',
					':scope > div > a.button'
				].join(',');
				const revealSections = Array.from(document.querySelectorAll(sectionSelector))
					.filter((section) => !section.closest('.form-section, .contact-section'));
				const revealStyles = ['reveal-rise', 'reveal-slide-left', 'reveal-slide-right'];

				if (!revealSections.length) {
					return;
				}

				document.documentElement.classList.add('reveal-motion');

				revealSections.forEach((section, sectionIndex) => {
					const items = Array.from(section.querySelectorAll(itemSelector));

					if (!items.length) {
						return;
					}

					section.classList.add('reveal-section', revealStyles[sectionIndex % revealStyles.length]);
					if (section.matches('.highlight, .cta, .cta-band')) {
						section.classList.add('cta-card-reveal');
					}

					items.forEach((item, itemIndex) => {
						item.classList.add('reveal-item');
						item.style.setProperty('--reveal-delay', `${Math.min(itemIndex * 110, 440)}ms`);
					});
				});

				if (!('IntersectionObserver' in window)) {
					revealSections.forEach((section) => section.classList.add('is-visible'));
					return;
				}

				const revealObserver = new IntersectionObserver(
					(entries, observer) => {
						entries.forEach((entry) => {
							if (!entry.isIntersecting) {
								return;
							}

							entry.target.classList.add('is-visible');
							observer.unobserve(entry.target);
						});
					},
					{
						rootMargin: '0px 0px -12% 0px',
						threshold: 0.08
					}
				);

				revealSections.forEach((section) => revealObserver.observe(section));
			})();

		</script>
	</body>
</html>

<style is:global>
	@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap');

	:root {
		--color-primary: #111111;
		--color-accent: #ACBC3B;
		--color-bg: #f3eee6;
		--color-text: #111111;
		--color-body: #111111d3;
		--color-strong: #DC4F41;
		--color-surface: #54B8ED;
		--color-surface-muted: #fffdf7;
		--color-border: #111111;
		--color-on-surface-light: #fffdf7;
		--color-on-surface-dark: #54B8ED;
		--color-on-muted: #fffdf7ec;
		--shadow-primary: 0 12px 24px rgba(18, 24, 38, 0.18);
		--shadow-button: 6px 8px 10px rgba(17, 17, 17, 0.3);
		--shadow-button-hover: 4px 5px 8px rgba(17, 17, 17, 0.26);
		--shadow-inset-box: inset 12px 12px 24px rgba(17, 17, 17, 0.18), inset -12px -12px 24px rgba(17, 17, 17, 0);
		--shadow-border-light: rgba(255, 253, 247, 0.12);
		--shadow-border-dark: rgba(0, 0, 0, 0.24);
		--gradient-brand: linear-gradient(83.21deg, #3245ff 0%, #bc52ee 100%);
		--gradient-alert: linear-gradient(14deg, #d83333 0%, #f041ff 100%);
		--gradient-code-bg: linear-gradient(66.77deg, #f3cddd 0%, #f5cee7 100%);
		--gradient-code-border: linear-gradient(155deg, #d83333 0%, #f041ff 18%, #f5cee7 45%);
		--surface-overlay: rgba(255, 253, 247, 0.55);
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
		font-family: 'Poppins', sans-serif;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		max-width: 100%;
		height: 100%;
		background: var(--color-bg);
		overflow-x: hidden;
		cursor: var(--hex-cursor-dark);
	}

	body {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		font-family: 'Poppins', sans-serif;
		cursor: var(--hex-cursor-dark);
	}

	.header,
	.footer,
	.hero-shell,
	.image-hero,
	.highlight,
	.cta,
	.cta-band,
	.form-next-actions,
	.thank-you-panel,
	.card:is(.process-card-red, .blog-card, .service-card-red) {
		cursor: var(--hex-cursor-light);
	}

	a,
	button,
	label,
	summary,
	[role='button'],
	input[type='button'],
	input[type='submit'],
	input[type='reset'] {
		cursor: inherit !important;
	}

	input,
	textarea,
	select {
		cursor: text;
	}

	body > main,
	body > .hero-shell {
		flex: 0 0 auto;
	}

	.header {
		flex: 0 0 auto;
		position: relative;
		z-index: 10;
		width: 100%;
		max-width: 100vw;
		background: var(--color-primary);
		padding: 1rem 0;
		box-shadow: 0 12px 32px rgba(0, 0, 0, 0.32);
	}

	.footer {
		flex: 0 0 auto;
		background: var(--color-primary);
		color: var(--color-on-surface-light);
		padding: 2rem 0;
		margin-top: auto;
	}

	.footer-spacer {
		flex: 0 0 50px;
		height: 50px;
	}

	.contact + .footer-spacer,
	.form-page.form-theme-blue + .footer-spacer {
		background: var(--color-surface);
	}

	.form-page.form-theme-red + .footer-spacer {
		background: var(--color-accent);
	}

	.form-page.form-theme-green + .footer-spacer {
		background: var(--color-strong);
	}

	.container {
		max-width: 1120px;
		margin: 0 auto;
		padding: 0 24px;
	}

	.header-content {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		width: 100%;
	}

	.logo-link {
		display: flex;
		align-items: center;
		text-decoration: none;
		flex-shrink: 0;
	}

	.logo {
		height: 40px;
		width: auto;
	}

	.mobile-menu,
	.mobile-menu-toggle {
		display: none;
	}

	.nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		align-items: center;
		margin-left: auto;
		justify-content: flex-end;
	}

	.nav-item {
		position: relative;
	}

	.nav-link {
		color: var(--color-on-surface-light);
		text-decoration: none;
		font-family: 'Poppins', sans-serif;
		font-weight: 600;
		font-size: 1rem;
		padding: 0.5rem 1rem;
		border-radius: 20px;
		transition: all 0.3s ease;
		background-color: transparent;
	}

	.submenu {
		position: absolute;
		top: calc(100% + 8px);
		right: 0;
		z-index: 20;
		display: grid;
		gap: 4px;
		min-width: 220px;
		padding: 12px;
		border-radius: 20px;
		background: var(--color-primary);
		box-shadow: var(--shadow-button), var(--shadow-inset-box);
		opacity: 0;
		visibility: hidden;
		transform: translateY(8px);
		transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s ease;
	}

	.has-submenu:hover .submenu,
	.has-submenu:focus-within .submenu {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}

	.submenu a {
		display: block;
		padding: 10px 12px;
		border-radius: 20px;
		color: var(--color-on-surface-light);
		font-weight: 700;
		text-decoration: none;
	}

	.submenu a:hover {
		color: var(--color-accent);
		background-color: rgba(172, 188, 59, 0.1);
	}

	.nav-link:hover {
		color: var(--color-accent);
		background-color: rgba(172, 188, 59, 0.1);
	}

	.footer-contact {
		text-align: center;
	}

	.footer-contact p {
		margin: 0.5rem 0;
	}

	.footer-logo-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		margin-bottom: 0.75rem;
		text-decoration: none;
	}

	.footer-logo {
		height: 48px;
		width: auto;
	}

	.footer a {
		color: var(--color-on-surface-light);
		text-decoration: none;
	}

	.footer a:hover {
		color: var(--color-accent);
	}

	.footer-email {
		font-size: 1rem;
	}

	.footer-email a {
		font-weight: 400;
	}

	.footer-links {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		justify-content: center;
		margin-top: 1rem;
		font-size: 0.88rem;
	}

	.footer-links a {
		font-weight: 400;
	}

	.page {
		max-width: 1120px;
		margin: 0 auto;
		padding: 72px 24px;
		color: var(--color-text);
	}

	.page-hero {
		padding: 42px 0 72px;
		max-width: 880px;
	}

	.page-hero.image-hero {
		position: relative;
		isolation: isolate;
		max-width: 100%;
		min-height: clamp(420px, 58vh, 620px);
		margin-bottom: 40px;
		padding: clamp(80px, 12vw, 140px) clamp(24px, 6vw, 72px);
		overflow: hidden;
		border-radius: 20px;
		background: var(--color-primary);
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
	}

	.page-hero.image-hero.full-bleed-hero {
		width: 100vw;
		max-width: 100vw;
		min-height: calc(100vh - 72px);
		min-height: calc(100svh - 72px);
		margin: -72px calc(50% - 50vw) 72px;
		padding:
			clamp(84px, 9vh, 116px)
			max(24px, calc((100vw - 1120px) / 2 + 24px))
			clamp(96px, 10vw, 140px);
		border-radius: 0;
	}

	.page-hero.image-hero.full-bleed-hero .lead {
		width: fit-content;
		padding: 18px 22px;
		border-radius: 16px;
		background: rgba(17, 17, 17, 0.8);
	}

	.page-hero.image-hero.full-bleed-hero h1 {
		letter-spacing: -0.015em;
	}

	.page-hero.image-hero::before,
	.page-hero.image-hero::after {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.page-hero.image-hero::before {
		z-index: 2;
		background: var(--hero-tint, rgba(84, 184, 237, 0.68));
		mix-blend-mode: multiply;
		opacity: 1;
		box-shadow:
			inset 0 0 0 1px rgba(255, 253, 247, 0.1),
			inset 18px 18px 42px rgba(17, 17, 17, 0.56),
			inset -18px -18px 42px rgba(17, 17, 17, 0.28);
	}

	.page-hero.image-hero::after {
		content: none;
	}

	.image-hero .hero-base-image,
	.image-hero .hero-pattern-image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		pointer-events: none;
	}

	.image-hero .hero-base-image {
		z-index: 0;
		filter: grayscale(1);
	}

	.image-hero .hero-pattern-image {
		z-index: 1;
		opacity: 0.44;
		filter: saturate(1.35) contrast(1.08);
		mix-blend-mode: screen;
		transform: scale(1.12) rotate(-7deg);
	}

	.page-hero.image-hero > :not(img) {
		position: relative;
		z-index: 3;
	}

	.page-hero.image-hero .eyebrow,
	.page-hero.image-hero h1,
	.page-hero.image-hero .lead {
		color: var(--color-on-surface-light);
	}

	.page-hero.center {
		text-align: center;
		margin: 0 auto;
	}

	.page-hero .eyebrow,
	.form-hero .eyebrow,
	.hero.image-hero .eyebrow {
		animation: copy-rise 1280ms cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.page-hero h1,
	.form-hero h1,
	.hero.image-hero h1 {
		animation: headline-slide 1640ms 120ms cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.page-hero .lead,
	.page-hero > p:not(.eyebrow),
	.form-hero > p:not(.eyebrow),
	.hero.image-hero > p:not(.eyebrow) {
		animation: copy-rise 1520ms 520ms cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.page-hero .button,
	.form-hero .button,
	.hero.image-hero .button {
		animation: copy-rise 1520ms 700ms cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.image-hero .hero-pattern-image {
		animation: hero-background-drift 36s ease-in-out infinite alternate;
	}

	@keyframes copy-rise {
		0% {
			opacity: 0;
			transform: translateY(18px);
		}

		100% {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes headline-slide {
		0% {
			opacity: 0;
			transform: translateX(-42px);
		}

		100% {
			opacity: 1;
			transform: translateX(0);
		}
	}

	@keyframes hero-background-drift {
		0% {
			transform: scale(1.12) rotate(-7deg) translate3d(-1%, -1%, 0);
		}

		100% {
			transform: scale(1.16) rotate(-5deg) translate3d(1%, 1%, 0);
		}
	}

	.eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.12em;
		font-size: 0.78rem;
		font-weight: 700;
		color: var(--color-muted, #111111a8);
		margin: 0 0 16px;
	}

	.page h1 {
		font-size: clamp(3rem, 7vw, 5.8rem);
		line-height: 1.06;
		margin: 0 0 24px;
		letter-spacing: -0.06em;
		color: var(--color-text);
	}

	.page h2 {
		font-size: clamp(2rem, 4vw, 3.2rem);
		line-height: 1;
		margin: 0 0 20px;
		letter-spacing: -0.045em;
		color: var(--color-text);
	}

	.page h3 {
		font-size: 1.25rem;
		margin: 0 0 12px;
		color: var(--color-text);
	}

	.page p,
	.page li {
		font-size: 1rem;
		line-height: 1.7;
		color: var(--color-body);
	}

	.lead {
		font-size: 1.18rem;
		max-width: 720px;
	}

	.center .lead {
		margin: 0 auto;
	}

	.section {
		padding: 64px 0;
		border-top: 0;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 20px;
		margin-top: 32px;
	}

	.two-column {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 40px;
		align-items: start;
	}

	.card {
		background: var(--color-surface-muted);
		border: 1px solid var(--color-border);
		border-radius: 20px;
		padding: 28px;
	}

